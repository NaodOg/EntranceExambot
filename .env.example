# Copy to apps/web/.env.local and fill in values.

# Convex (from `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Telegram bot (from BotFather — name/handle TBD)
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=EntranceExamStudybot

# Public URL of the Mini App (Vercel production or ngrok for local webhook testing)
NEXT_PUBLIC_MINI_APP_URL=http://localhost:3000/app

# Admin panel
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=you@example.com
# Optional. Admin session tokens are signed with a key derived from
# TELEGRAM_BOT_TOKEN (shared by Next + Convex), so this is NOT required.
# If set, it is also accepted as a signing secret (legacy compatibility).
ADMIN_SESSION_SECRET=

# Optional: bearer secret for GET /api/telegram/cron (Vercel Cron). If unset,
# the route only accepts an authenticated admin session.
CRON_SECRET=

# Optional: explicit webhook secret. If unset, one is derived from
# TELEGRAM_BOT_TOKEN automatically, so the webhook is always authenticated.
TELEGRAM_WEBHOOK_SECRET=

# Optional: Telegram Premium custom emoji on chat menu buttons (icon_custom_emoji_id).
# Requires bot owner Premium or Fragment username. Leave unset for normal Unicode emojis in labels.
# Get IDs: send the emoji to @RawDataBot or inspect message.entities[].custom_emoji_id
# TELEGRAM_MENU_EMOJI_QUIZ=
# TELEGRAM_MENU_EMOJI_MOCK=
# TELEGRAM_MENU_EMOJI_DAILY=
# TELEGRAM_MENU_EMOJI_STATS=
# TELEGRAM_MENU_EMOJI_RANKS=
# TELEGRAM_MENU_EMOJI_MORE=

# Optional: used by Vercel / Convex deployment
CONVEX_DEPLOYMENT=
